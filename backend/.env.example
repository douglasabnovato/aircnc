# Copie para .env (nunca versione o .env)
# MongoDB Atlas M0 (gratuito): crie um usuário NOVO; a senha antiga estava no código
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/aircnc
# 32+ caracteres aleatórios (ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:3333
PORT=3333
